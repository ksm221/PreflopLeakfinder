<Window x:Class="PokerStudy.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Preflop Leakfinder" Height="760" Width="1400">
    <TabControl Margin="12">
        <TabItem Header="Hands">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Width="120" Margin="0,0,8,0" Click="Import_Click">Import Folder</Button>
                    <Button Width="100" Margin="0,0,8,0" Click="Refresh_Click">Refresh</Button>
                    <Button Width="100" Margin="0,0,8,0" Click="Cancel_Click">Cancel</Button>
                    <Button Width="120" Click="ClearData_Click">Clear Data</Button>
                    <TextBlock Margin="20,4,0,0" Text="{Binding StatusText}"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="FormatFilter" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="HU"/>
                        <ComboBoxItem Content="3W"/>
                    </ComboBox>
                    <ComboBox x:Name="PositionFilter" Grid.Column="1" Margin="8,0" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="BTN"/>
                        <ComboBoxItem Content="SB"/>
                        <ComboBoxItem Content="BB"/>
                    </ComboBox>
                    <TextBox x:Name="SearchBox" Grid.Column="2" Margin="8,0" TextChanged="FilterChanged" ToolTip="Hand ID / starting hand / spot"/>
                    <ComboBox x:Name="GtoFilter" Grid.Column="3" Width="180" Margin="8,0" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="All GTO Results"/>
                        <ComboBoxItem Content="Deviation Only"/>
                    </ComboBox>
                    <TextBlock x:Name="CountText" Grid.Column="3" VerticalAlignment="Center" Margin="196,0,8,0"/>
                </Grid>
                <DataGrid x:Name="HandsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.CanContentScroll="True" RowDetailsVisibilityMode="Collapsed" MouseDoubleClick="HandsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hand ID" Binding="{Binding HandId}" Width="260"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding PlayedAtUtc}" Width="150"/>
                        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="70"/>
                        <DataGridTextColumn Header="Pos" Binding="{Binding HeroPosition}" Width="60"/>
                        <DataGridTextColumn Header="Stack BB" Binding="{Binding StackBb,StringFormat=0}" Width="80"/>
                        <DataGridTextColumn Header="Hand" Binding="{Binding StartingHand}" Width="70"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding HeroAction}" Width="90"/>
                        <DataGridTextColumn Header="Spot" Binding="{Binding Spot}" Width="380"/>
                        <DataGridTextColumn Header="GTO" Binding="{Binding GtoVerdict}" Width="90"/>
                        <DataGridTextColumn Header="GTO Detail" Binding="{Binding GtoDetail}" Width="380"/>
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8" Margin="0,4">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="420">
                                    <TextBox Text="{Binding RawText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"/>
                                </ScrollViewer>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
                <ProgressBar Grid.Row="3" Height="20" Margin="0,10,0,0" x:Name="Progress"/>
            </Grid>
        </TabItem>

        <TabItem Header="Summary">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="260"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="AllTimeCheck" Content="All time" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" Checked="DateRangeToggle_Changed" Unchecked="DateRangeToggle_Changed"/>
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker x:Name="FromDate" Width="130" Margin="0,0,16,0" IsEnabled="False"/>
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker x:Name="ToDate" Width="130" Margin="0,0,16,0" IsEnabled="False"/>
                    <ComboBox x:Name="SummaryFormatFilter" Width="150" Margin="0,0,12,0" SelectionChanged="SummaryFilterChanged">
                        <ComboBoxItem Content="All Formats" IsSelected="True"/>
                        <ComboBoxItem Content="3W"/>
                        <ComboBoxItem Content="HU"/>
                    </ComboBox>
                    <Button Width="140" Click="RefreshSummary_Click">Refresh Summary</Button>
                    <TextBlock x:Name="SummaryStatusText" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" x:Name="SummaryHeadlineText" FontSize="18" FontWeight="Bold" Margin="0,16,0,12"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Mistakes by Position (click a row)" FontWeight="Bold" Margin="0,0,0,6"/>
                        <DataGrid x:Name="PositionStatsGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="220" SelectionUnit="FullRow" SelectionMode="Single" SelectionChanged="PositionStatsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="90"/>
                                <DataGridTextColumn Header="Deviations" Binding="{Binding Count}" Width="90"/>
                                <DataGridTextColumn Header="% of total" Binding="{Binding Pct,StringFormat={}{0:0.#}%}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0">
                        <TextBlock Text="Mistakes by Stack Depth (5bb+ only, click a row)" FontWeight="Bold" Margin="0,0,0,6"/>
                        <DataGrid x:Name="StackStatsGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="220" SelectionUnit="FullRow" SelectionMode="Single" SelectionChanged="StackStatsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stack Range" Binding="{Binding Bucket}" Width="100"/>
                                <DataGridTextColumn Header="Deviations" Binding="{Binding Count}" Width="90"/>
                                <DataGridTextColumn Header="% of total" Binding="{Binding Pct,StringFormat={}{0:0.#}%}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="Most Frequent Deviation Hands (click a row)" FontWeight="Bold" Margin="0,0,0,6"/>
                        <DataGrid x:Name="HandStatsGrid"
                                              ItemsSource="{Binding HandStats}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Height="220"
                                              SelectionUnit="FullRow"
                                              SelectionMode="Single"
                                              SelectionChanged="HandStatsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hand" Binding="{Binding Hand}" Width="80"/>
                                <DataGridTextColumn Header="Deviations" Binding="{Binding Count}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="3" Text="Selected Hand:" FontSize="16" FontWeight="Bold" Margin="0,16,0,8"/>
                <DataGrid Grid.Row="4" x:Name="SelectedHandGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionUnit="FullRow"
                          SelectionMode="Single"
                          SelectionChanged="SelectedHandGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding HandId}" Width="220"/>
                        <DataGridTextColumn Header="Position" Binding="{Binding HeroPosition}" Width="90"/>
                        <DataGridTextColumn Header="Hand" Binding="{Binding StartingHand}" Width="70"/>
                        <DataGridTextColumn Header="Stack Depth" Binding="{Binding StackBb,StringFormat=0}" Width="100"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding HeroAction}" Width="100"/>
                        <DataGridTextColumn Header="GTO Detail" Binding="{Binding GtoDetail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="5" Text="Summary" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                <Border Grid.Row="6" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="SelectedDeviationText"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 Text="Click a hand above, then a row in Selected Hand, to see its details here."/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Window>